{
  "name": "stems: endless, seamless playback",
  "short_name": "stems",
  "description": "Play any song forever with inaudible, beat-matched seams. Stem separation and seamless loop export, all on-device.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0d0f14",
  "theme_color": "#0d0f14",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "audio/*": [".mp3", ".wav", ".flac", ".m4a", ".ogg", ".aac", ".opus"] } }
  ]
}
