# Copy to .env and fill in. Never commit .env.
#
# Spotify (free developer app, PKCE — no client secret needed in the browser).
# Optional: the code ships with the "stems" app's public Client ID as the
# default, so this is only needed to use a different app. If you create your
# own at https://developer.spotify.com/dashboard, register these Redirect
# URIs exactly:
#   http://127.0.0.1:5173/
#   https://edwin580.github.io/stems/
# Note: Spotify rejects "localhost" in redirect URIs — use 127.0.0.1 for
# local dev (open http://127.0.0.1:5173/ in the browser, not localhost).
VITE_SPOTIFY_CLIENT_ID=

# YouTube Data API v3 key (optional — only enables in-app YouTube search;
# pasting links works without it).
VITE_YOUTUBE_API_KEY=

# YouTube -> MP3 converter endpoint (optional — only needed to convert a
# YouTube link into an MP3 that feeds the stem/endless engine). Leave unset
# for the default same-origin /api/youtube-mp3: the Vite dev server proxies
# it to the local converter started with `npm run yt-server` (needs yt-dlp +
# ffmpeg on that machine). Set this to the base URL (or full endpoint URL)
# of a deployed converter instead, e.g. https://convert.example.com/api
VITE_YT_MP3_API_URL=

# YouTube relay for the static site (relay/youtube-relay.js deployed as a
# Cloudflare Worker). Optional: people can also paste a relay URL in the app
# ("YouTube relay"), which is saved in their browser and wins over this.
VITE_YT_RELAY_URL=
